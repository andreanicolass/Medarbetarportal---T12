@model IEnumerable<Medarbetarportal.Web.Models.Benefit>

@{
    ViewData["Title"] = "Förmånsportal";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    
    .dashboard-bg {
        background: #f8f9fa;
        min-height: 100vh;
        padding-top: 2rem;
    }

    .william-card {
        border: none;
        border-radius: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #ffffff;
    }

    .william-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }

    .icon-box {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #28a745 0%, #1c7430 100%);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .price-tag {
        color: #28a745;
        font-weight: 800;
        font-size: 1.5rem;
    }

    .custom-badge {
        background: rgba(40, 167, 69, 0.1);
        color: #1c7430;
        border: 1px solid rgba(40, 167, 69, 0.2);
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 8px;
    }
</style>

<div class="dashboard-bg">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold text-dark">Välkommen till Portalen</h1>
            <p class="lead text-muted">Här hittar du dina aktuella förmåner och erbjudanden.</p>
        </div>

        <div class="row">
            @if (Model != null && Model.Any())
            {
                @foreach (var benefit in Model)
                {
                    var iconClass = benefit.Title?.ToLower() switch
                    {
                        var t when t.Contains("padel") => "bi-trophy",
                        var t when t.Contains("golf") => "bi-flag-fill",
                        var t when t.Contains("skid") => "bi-snow",
                        var t when t.Contains("gym") => "bi-person-arms-up",
                        _ => "bi-star-fill"
                    };

                    <div class="col-md-4 mb-4">
                        <div class="card h-100 william-card shadow-sm p-3">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="icon-box">
                                        <i class="bi @iconClass"></i>
                                    </div>
                                    <span class="custom-badge">Aktiv Förmån</span>
                                </div>

                                <h4 class="card-title fw-bold text-dark">@benefit.Title</h4>
                                <p class="card-text text-muted">@benefit.Description</p>

                                <div class="mt-auto pt-3 border-top border-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <small class="text-muted d-block">Månadskostnad</small>
                                            <span class="price-tag">@benefit.Price kr</span>
                                        </div>
                                        <a href="#" class="btn btn-dark btn-sm rounded-pill px-4">Läs mer</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="alert alert-info shadow-sm border-0 rounded-4 p-5">
                        <i class="bi bi-cloud-slash display-1 d-block mb-3"></i>
                        <h4 class="alert-heading fw-bold">Hittade inga förmåner just nu</h4>
                        <p class="mb-0">Kontrollera att ditt <strong>Benefits-Api</strong> är igång och att porten stämmer i DashboardController.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>