@{
    Layout = null;
    ViewData["Title"] = "StatistikAPI - Dashboard";
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StatistikAPI - Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            background: white;
            padding: 20px 30px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo h1 {
            color: #667eea;
            font-size: 24px;
        }

        .logo p {
            color: #666;
            font-size: 14px;
        }

        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            text-align: center;
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h3 {
            color: #666;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .card .value {
            font-size: 48px;
            font-weight: bold;
            color: #667eea;
        }

        .card .unit {
            color: #999;
            font-size: 14px;
        }

        footer {
            background: white;
            text-align: center;
            padding: 20px;
            border-radius: 10px;
            color: #666;
            margin-top: 30px;
        }

        .loading {
            text-align: center;
            padding: 20px;
            color: white;
            font-size: 18px;
        }

        .error {
            background: #fed7d7;
            color: #c53030;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            text-align: center;
        }

        .refresh-btn {
            background: #667eea;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
            font-size: 14px;
        }

        .refresh-btn:hover {
            background: #5a67d8;
        }

        .last-updated {
            text-align: center;
            margin-top: 20px;
            color: #888;
            font-size: 12px;
        }

        .button-container {
            text-align: center;
            margin-top: 20px;
        }
    </style>
</head>
<body>
<div class="container">
    <header>
        <div class="logo">
            <h1>📊 Förmånsportal Statistik</h1>
            <p>Översikt och analys</p>
        </div>
    </header>

    <div id="errorMessage" class="error" style="display: none;"></div>
    <div id="loading" class="loading" style="display: none;">Laddar data...</div>

    <div class="dashboard">
        <div class="card">
            <h3>📋 Totalt antal förmåner</h3>
            <div class="value" id="totalBenefits">-</div>
            <div class="unit">aktiva förmåner</div>
        </div>
        <div class="card">
            <h3>👥 Totalt antal användare</h3>
            <div class="value" id="totalUsers">-</div>
            <div class="unit">registrerade</div>
        </div>
        <div class="card">
            <h3>📝 Totalt antal ansökningar</h3>
            <div class="value" id="totalApplications">-</div>
            <div class="unit">inskickade</div>
        </div>
    </div>

    <div class="button-container">
        <button class="refresh-btn" onclick="loadDashboardData()">🔄 Uppdatera data</button>
    </div>

    <footer>
        <p>Medarbetarförmånsportal © 2026 | StatistikAPI v1.0</p>
        <p class="last-updated" id="lastUpdated">Senast uppdaterad: -</p>
    </footer>
</div>

<script>
    const API_BASE = window.location.origin;

    function showLoading() {
        document.getElementById('loading').style.display = 'block';
    }

    function hideLoading() {
        document.getElementById('loading').style.display = 'none';
    }

    function showError(message) {
        const errorDiv = document.getElementById('errorMessage');
        errorDiv.textContent = message;
        errorDiv.style.display = 'block';
        setTimeout(() => {
            errorDiv.style.display = 'none';
        }, 5000);
    }

    function updateLastUpdated() {
        const now = new Date();
        document.getElementById('lastUpdated').textContent = `Senast uppdaterad: ${now.toLocaleTimeString()}`;
    }

    async function loadDashboardData() {
        showLoading();

        try {
            // Försök hämta dashboard-summary
            const response = await fetch(`${API_BASE}/api/statistics/dashboard-summary`);
            if (response.ok) {
                const data = await response.json();
                document.getElementById('totalBenefits').textContent = data.totalBenefits || 0;
                document.getElementById('totalUsers').textContent = data.totalUsers || 0;
                document.getElementById('totalApplications').textContent = data.totalApplications || 0;
            } else {
                // Om dashboard-summary inte fungerar, försök hämta individuellt
                await loadIndividualStats();
            }
        } catch (error) {
            console.log('Dashboard summary failed, trying individual endpoints...');
            await loadIndividualStats();
        }

        updateLastUpdated();
        hideLoading();
    }

    async function loadIndividualStats() {
        // Försök hämta totalBenefits
        try {
            const benefitsRes = await fetch(`${API_BASE}/api/statistics/total-benefits`);
            if (benefitsRes.ok) {
                const benefits = await benefitsRes.json();
                document.getElementById('totalBenefits').textContent = benefits;
            }
        } catch (e) {
            document.getElementById('totalBenefits').textContent = '?';
        }

        // Försök hämta totalUsers
        try {
            const usersRes = await fetch(`${API_BASE}/api/statistics/total-users`);
            if (usersRes.ok) {
                const users = await usersRes.json();
                document.getElementById('totalUsers').textContent = users;
            }
        } catch (e) {
            document.getElementById('totalUsers').textContent = '?';
        }

        // Försök hämta totalApplications
        try {
            const appsRes = await fetch(`${API_BASE}/api/statistics/total-applications`);
            if (appsRes.ok) {
                const apps = await appsRes.json();
                document.getElementById('totalApplications').textContent = apps;
            }
        } catch (e) {
            document.getElementById('totalApplications').textContent = '?';
        }
    }

    // Ladda dashboard när sidan startar
    loadDashboardData();
</script>
</body>
</html>